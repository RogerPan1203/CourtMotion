#!/usr/bin/env bash
set -u

BASE="$HOME/Tennis"
RUN_DIR="$BASE/.run"
PID_FILE="$RUN_DIR/tennis.pid"
MODE_FILE="$RUN_DIR/tennis.mode"
LOG_FILE="$RUN_DIR/tennis.log"

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
DIM='\033[2m'
RESET='\033[0m'

mkdir -p "$RUN_DIR"

usage() {
  cat <<'EOF'
Usage:
  tennis on | steady [options] Hold two selected channels until stopped
  tennis off | stop       Safely stop the running mode
  tennis status           Show current state
  tennis log              Show the latest output
  tennis watch            Show live court (Ctrl+C safely stops motor)

Options passed to steady:
  --channel-a 1..12 --channel-b 1..12 (different when both on; default 2 and 4)
  --a-pct 0..100   --b-pct 0..100   (default 30% each)
  --disable-a      --disable-b      (run only the other motor)
EOF
}

banner() {
  local color="$1" title="$2" subtitle="$3"
  printf "${color}╭──────────────────────────────────╮${RESET}\n"
  printf "${color}│${RESET}  🎾  %-27s${color}│${RESET}\n" "$title"
  printf "${color}│${RESET}  %-31s ${color}│${RESET}\n" "$subtitle"
  printf "${color}╰──────────────────────────────────╯${RESET}\n"
}

running_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  read -r pid < "$PID_FILE"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

force_all_off() {
  local off_script="$BASE/pca_all_off.py"
  if [ ! -f "$off_script" ]; then
    printf "${RED}Safety shutdown helper is missing: %s${RESET}\n" "$off_script" >&2
    return 1
  fi
  if ! python3 "$off_script" >> "$LOG_FILE" 2>&1; then
    printf "${RED}Could not reset the PCA9685. Disconnect motor power now.${RESET}\n" >&2
    return 1
  fi
}

stop_tennis() {
  local pid="" tracked="" discovered="" pids=""
  tracked="$(running_pid 2>/dev/null || true)"
  discovered="$(pgrep -f "^python3 -u ${BASE}/pca_(ch1_30pct|sweep_independant)\.py( .*)?$" 2>/dev/null || true)"
  pids="$(printf '%s\n%s\n' "$tracked" "$discovered" | awk 'NF && !seen[$0]++')"

  if [ -z "$pids" ]; then
    printf "${DIM}No tracked process; forcing a hardware reset anyway.${RESET}\n"
  else
    printf "${YELLOW}🎾 Match point… stopping controller(s): %s${RESET}\n" "$(echo "$pids" | tr '\n' ' ')"
    for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done
    for _ in $(seq 1 10); do
      local alive=0
      for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
      [ "$alive" -eq 0 ] && break
      sleep 0.1
    done
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then
        printf "${RED}PID %s did not stop; sending KILL.${RESET}\n" "$pid" >&2
        kill -KILL "$pid" 2>/dev/null || true
      fi
    done
  fi

  rm -f "$PID_FILE" "$MODE_FILE"
  if ! force_all_off; then
    return 1
  fi
  banner "$CYAN" "GAME OVER" "All channels are safely off"
}

start_tennis() {
  local mode="$1" script
  shift
  case "$mode" in
    steady) script="$BASE/pca_ch1_30pct.py" ;;
    *) echo "Unknown mode: $mode" >&2; usage; exit 2 ;;
  esac

  [ -f "$script" ] || { echo "Missing program: $script" >&2; exit 1; }
  if running_pid >/dev/null; then
    stop_tennis
  fi

  : > "$LOG_FILE"
  # Reset SIGINT before exec so `tennis stop` reaches Python's safe cleanup.
  nohup bash -c 'trap - INT; exec python3 -u "$@"' _ "$script" "$@" \
    >> "$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  printf '%s\n' "$mode" > "$MODE_FILE"
  sleep 0.5

  if ! kill -0 "$pid" 2>/dev/null; then
    echo "Tennis failed to start. Recent log:" >&2
    tail -n 20 "$LOG_FILE" >&2
    rm -f "$PID_FILE" "$MODE_FILE"
    exit 1
  fi

  banner "$GREEN" "GAME ON!" "Mode: $mode  •  PID: $pid"
  printf "${CYAN}  tennis watch${RESET}  live court   ${YELLOW}tennis off${RESET}  safe stop\n"
}

watch_tennis() {
  local pid mode frame=0 pos spaces
  if ! pid="$(running_pid)"; then
    banner "$DIM" "NO MATCH" "Start one with: tennis on"
    return 1
  fi

  mode="unknown"
  [ -f "$MODE_FILE" ] && read -r mode < "$MODE_FILE"
  printf '\033[?25l'
  trap 'printf "\033[?25h\n"; stop_tennis; exit 130' INT TERM HUP
  trap 'printf "\033[?25h"' EXIT

  while kill -0 "$pid" 2>/dev/null; do
    pos=$((frame % 58))
    if [ "$pos" -gt 29 ]; then pos=$((58 - pos)); fi
    printf -v spaces '%*s' "$pos" ''
    printf '\033[H\033[2J'
    printf "${GREEN}╭──────────────────────────────────╮${RESET}\n"
    printf "${GREEN}│${RESET}  🎾  ${YELLOW}TENNIS LIVE${RESET}                  ${GREEN}│${RESET}\n"
    printf "${GREEN}├──────────────────────────────────┤${RESET}\n"
    printf "${GREEN}│${RESET} %-32s ${GREEN}│${RESET}\n" "Mode: $mode"
    printf "${GREEN}│${RESET}                                  ${GREEN}│${RESET}\n"
    printf "${GREEN}│${RESET}  ${spaces}${YELLOW}●${RESET}%*s${GREEN}│${RESET}\n" "$((31 - pos))" ''
    printf "${GREEN}│${RESET}────────────────┼─────────────────${GREEN}│${RESET}\n"
    printf "${GREEN}│${RESET}                                  ${GREEN}│${RESET}\n"
    printf "${GREEN}╰──────────────────────────────────╯${RESET}\n"
    printf "${YELLOW}Ctrl+C safely stops the motor and exits.${RESET}\n"
    frame=$((frame + 1))
    sleep 0.12
  done

  printf '\033[?25h\033[H\033[2J'
  rm -f "$PID_FILE" "$MODE_FILE"
  force_all_off || true
  banner "$CYAN" "MATCH FINISHED" "The motor process has stopped"
}

command="${1:-status}"
[ "$#" -gt 0 ] && shift
case "$command" in
  on|steady) start_tennis steady "$@" ;;
  off|stop) stop_tennis ;;
  status)
    if pid="$(running_pid)"; then
      mode="unknown"
      [ -f "$MODE_FILE" ] && read -r mode < "$MODE_FILE"
      banner "$GREEN" "PLAYING" "Mode: $mode  •  PID: $pid"
    else
      rm -f "$PID_FILE" "$MODE_FILE"
      banner "$DIM" "COURT IS QUIET" "Tennis is off"
    fi
    ;;
  log)
    [ -f "$LOG_FILE" ] && tail -n 30 "$LOG_FILE" || echo "No Tennis log yet."
    ;;
  watch) watch_tennis ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
